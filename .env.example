# SAFE TEMPLATE ONLY. Copy to private deployment environment; fill placeholders.
# Canonical DJANGO_* names take precedence over legacy SECRET_KEY/DEBUG/ALLOWED_HOSTS.
ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com
# Empty for same-origin admin/native Android; add only trusted HTTPS origins.
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
# Production URL default requires SSL; verify-full + sslrootcert supported in URL.
DATABASE_SSL_REQUIRE=true
DATABASE_CONN_MAX_AGE=60
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# Public operator configuration: legal routes substitute these into escaped HTML.
RYTM_SUPPORT_EMAIL=
RYTM_LEGAL_ENTITY=
SECURE_SSL_REDIRECT=true
# Set true ONLY after the trusted proxy strips/spoof-proofs forwarding headers.
TRUST_PROXY_SSL_HEADER=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_ACCESS_LOG=false
# OPTIONAL for public API startup. Configure only where ingestion runs.
EVENT_EXTRACTION_PROVIDER=openai
EVENT_EXTRACTION_MODEL=gpt-6-luna
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
GEOCODING_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=RytmAdmin/1.0 (SET_OPERATOR_CONTACT_BEFORE_GEOCODING)
# Local docker-compose PostGIS only (not used when DATABASE_URL is set).
POSTGRES_DB=rytm_db
POSTGRES_USER=rytm_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
